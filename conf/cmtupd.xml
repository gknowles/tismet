<Comments>
  <Rule name="Copyright">
    <Var name="Owner" value="Glen Knowles"/>
    <Match regex="{Prefix}Copyright {Owner} (\d\d\d\d)(?: - (\d\d\d\d))?\."
        replace="{Prefix}Copyright {Owner} {FirstYear} - {$CurrentYear}.">
      <Capture var="FirstYear"/>
      <Capture var="LastYear" default="{FirstYear}"/>
      <Action type="skip" arg1="{LastYear}" op=">" arg2="{$CommitYear}"
          report="NEWER" reportType="warn"/>
      <Action type="update" arg1="{LastYear}" op="&lt;" arg2="{$CommitYear}"
          report="UPDATED" reportType="note"
          checkReport="obsolete" checkReportType="warn"/>
    </Match>
    <Group>
      <File regex="CMakeLists\.txt"/>
      <File regex=".*\.cmake"/>
      <File regex=".*\.yaml"/>
      <File regex=".*\.yml"/>
      <File regex=".*\.rb"/>
      <Exclude regex="CMakeDeps\.cmake"/>
      <Var name="Prefix" value="# "/>
    </Group>
    <Group>
      <File regex=".*\.cpp"/>
      <File regex=".*\.h"/>
      <Exclude regex=".*\.g\.cpp"/>
      <Exclude regex=".*\.g\.h"/>
      <Exclude regex="libs/carbon/carbonparse\.cpp"/>
      <Exclude regex="libs/carbon/carbonparseint\.h"/>
      <Exclude regex="libs/func/fnenum\.h"/>
      <Exclude regex="libs/query/qryparse\.cpp"/>
      <Exclude regex="libs/query/qryparseint\.h"/>
      <Exclude regex="libs/query/qryparseimplfnint\.h"/>
      <Exclude regex="tools/tismet/resource\.h"/>
      <Exclude regex="tools/tismet/tswebcontent\.cpp"/>
      <Var name="Prefix" value="// "/>
    </Group>
    <Group>
      <File regex=".*\.css"/>
      <File regex=".*\.html"/>
      <File regex=".*\.js"/>
      <Exclude regex=".*\.g\.js"/>
      <Exclude regex="web/srv/vendor/.*"/>
      <Exclude regex="site/vendor/.*"/>
      <File regex=".*\.adoc"/>
      <File regex=".*\.md"/>
      <File regex=".*\.natvis"/> <!-- xml -->
      <File regex=".*\.xml"/>
      <File regex=".*\.xml\.sample"/>
      <File regex=".*\.xsd"/>
      <Exclude regex="tools/.*/schema\.xsd"/>
      <Var name="Prefix" value=""/>
    </Group>
    <Group>
      <File regex=".*\.rst"/>
      <Var name="Prefix" value=".. "/>
    </Group>
    <Group>
      <File regex=".*\.abnf"/>
      <Exclude regex="libs/query/queryfunc\.abnf"/>
      <Var name="Prefix" value="; "/>
    </Group>
    <Group>
      <File regex=".*\.bat"/>
      <Var name="Prefix" value=":: "/>
    </Group>
  </Rule>
</Comments>
